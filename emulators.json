[
  {
    "id": "duckstation",
    "name": "DuckStation",
    "systems": [
      "ps1"
    ],
    "source": {
      "type": "github",
      "repo": "stenzek/duckstation",
      "prerelease": true
    },
    "asset": "^duckstation-windows-x64-release\\.zip$",
    "exe": "^duckstation-qt.*\\.exe$",
    "args": "-batch -fullscreen {rom}",
    "linux": {
      "asset": "^DuckStation-x64.AppImage$",
      "exe": "^DuckStation-x64.AppImage$"
    },
    "mac": {
      "asset": "^duckstation-mac-release\\.zip$",
      "exe": "^DuckStation.*\\.app$"
    }
  },
  {
    "id": "pcsx2",
    "name": "PCSX2",
    "systems": [
      "ps2"
    ],
    "source": {
      "type": "github",
      "repo": "PCSX2/pcsx2",
      "prerelease": false
    },
    "asset": "windows-x64-Qt\\.7z$",
    "exe": "^pcsx2-qt\\.exe$",
    "args": "-batch -fullscreen -- {rom}",
    "linux": {
      "asset": "-linux-appimage-x64-Qt.AppImage$",
      "exe": "-linux-appimage-x64-Qt.AppImage$"
    },
    "mac": {
      "asset": "-macos-Qt\\.tar\\.xz$",
      "exe": "^PCSX2.*\\.app$"
    }
  },
  {
    "id": "rpcs3",
    "name": "RPCS3",
    "systems": [
      "ps3"
    ],
    "source": {
      "type": "github",
      "repo": "RPCS3/rpcs3-binaries-win",
      "prerelease": false
    },
    "asset": "_win64\\.7z$",
    "exe": "^rpcs3\\.exe$",
    "args": "--no-gui {rom}",
    "linux": {
      "repo": "RPCS3/rpcs3-binaries-linux",
      "asset": "_linux64.AppImage$",
      "exe": "_linux64.AppImage$"
    },
    "mac": {
      "repo": "RPCS3/rpcs3-binaries-mac",
      "asset": "_macos\\.7z$",
      "exe": "^RPCS3.*\\.app$"
    }
  },
  {
    "id": "shadps4",
    "name": "shadPS4",
    "systems": [
      "ps4"
    ],
    "source": {
      "type": "github",
      "repo": "shadps4-emu/shadPS4",
      "prerelease": true
    },
    "asset": "^shadps4-win64-sdl.*\\.zip$",
    "exe": "^shadps4\\.exe$",
    "args": "-g {rom}",
    "linux": {
      "asset": "^shadps4-linux-sdl-.*.zip$",
      "exe": "^shadps4.*.AppImage$"
    },
    "mac": {
      "asset": "^shadps4-macos-sdl-.*\\.zip$",
      "exe": "^shadps4.*\\.app$"
    }
  },
  {
    "id": "ppsspp",
    "name": "PPSSPP",
    "systems": [
      "psp"
    ],
    "source": {
      "type": "github",
      "repo": "hrydgard/ppsspp",
      "prerelease": false
    },
    "asset": "-Windows-x64\\.zip$",
    "exe": "^PPSSPPWindows64\\.exe$",
    "args": "--fullscreen {rom}",
    "linux": {
      "asset": "-anylinux-x86_64.AppImage$",
      "exe": "-anylinux-x86_64.AppImage$"
    },
    "mac": {
      "asset": "^PPSSPPSDL-macOS-.*\\.zip$",
      "exe": "^PPSSPP.*\\.app$"
    }
  },
  {
    "id": "cemu",
    "name": "Cemu",
    "systems": [
      "wiiu"
    ],
    "source": {
      "type": "github",
      "repo": "cemu-project/Cemu",
      "prerelease": false
    },
    "asset": "windows-x64\\.zip$",
    "exe": "^Cemu\\.exe$",
    "args": "-f -g {rom}",
    "linux": {
      "asset": "-x86_64.AppImage$",
      "exe": "-x86_64.AppImage$"
    },
    "mac": {
      "asset": "-macos-12-x64\\.dmg$",
      "exe": "^Cemu.*\\.app$"
    }
  },
  {
    "id": "azahar",
    "name": "Azahar",
    "systems": [
      "3ds"
    ],
    "source": {
      "type": "github",
      "repo": "azahar-emu/azahar",
      "prerelease": true
    },
    "asset": "^azahar-windows-msvc-.*.zip$",
    "exe": "^azahar\\.exe$",
    "args": "{rom}",
    "linux": {
      "asset": "^azahar.AppImage$",
      "exe": "^azahar.AppImage$"
    },
    "mac": {
      "asset": "^azahar-macos-universal-.*\\.zip$",
      "exe": "^Azahar.*\\.app$"
    }
  },
  {
    "id": "melonds",
    "name": "melonDS",
    "systems": [
      "nds"
    ],
    "source": {
      "type": "github",
      "repo": "melonDS-emu/melonDS",
      "prerelease": false
    },
    "asset": "windows-x86_64\\.zip$",
    "exe": "^melonDS\\.exe$",
    "args": "{rom}",
    "linux": {
      "asset": "-appimage-x86_64.zip$",
      "exe": "^melonDS.*.AppImage$"
    },
    "mac": {
      "asset": "-macOS-universal\\.zip$",
      "exe": "^melonDS.*\\.app$"
    }
  },
  {
    "id": "mgba",
    "name": "mGBA",
    "systems": [
      "gba",
      "gbc"
    ],
    "source": {
      "type": "github",
      "repo": "mgba-emu/mgba",
      "prerelease": false
    },
    "asset": "-win64\\.7z$",
    "exe": "^mGBA\\.exe$",
    "args": "-f {rom}",
    "linux": {
      "asset": "-appimage-x64.appimage$",
      "exe": "-appimage-x64.appimage$"
    },
    "mac": {
      "asset": "-macos\\.dmg$",
      "exe": "^mGBA.*\\.app$"
    }
  },
  {
    "id": "flycast",
    "name": "Flycast",
    "systems": [
      "dreamcast"
    ],
    "source": {
      "type": "github",
      "repo": "flyinghead/flycast",
      "prerelease": false
    },
    "asset": "^flycast-win64-.*\\.zip$",
    "exe": "^flycast\\.exe$",
    "args": "{rom}",
    "linux": {
      "asset": "^flycast-x86_64-.*.AppImage$",
      "exe": "^flycast-x86_64-.*.AppImage$"
    },
    "mac": {
      "asset": "^flycast-macOS-.*\\.zip$",
      "exe": "^Flycast.*\\.app$"
    }
  },
  {
    "id": "xemu",
    "name": "xemu",
    "systems": [
      "xbox"
    ],
    "source": {
      "type": "github",
      "repo": "xemu-project/xemu",
      "prerelease": true
    },
    "asset": "^(?!.*-dbg-)(?!.*pdb).*-windows-x86_64\\.zip$",
    "exe": "^xemu\\.exe$",
    "args": "-full-screen -dvd_path {rom}",
    "linux": {
      "asset": "^xemu-(?!.*-dbg-).*-x86_64.AppImage$",
      "exe": "^xemu-.*-x86_64.AppImage$"
    },
    "mac": {
      "asset": "^xemu-(?!.*-dbg-).*-macos-universal\\.zip$",
      "exe": "^xemu.*\\.app$"
    }
  }
]
